{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar-workspace",
  "account_id": "c82e3ca0932179eba19918aee28a9845",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "triggers": { "crons": ["0 0,12 * * *", "*/15 * * * *"] },
  "workflows": [{ "name": "ar-workspace-refresh", "binding": "AR_REFRESH", "class_name": "ArRefreshWorkflow" }],
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    "SUPABASE_URL": "https://jmyvpurzmoiecpydjrci.supabase.co",
    "OPERA_BASE_URL": "https://mtcb2pr.hospitality-api.ap-mumbai-1.ocs.oraclecloud.com",
    "OPERA_ENTERPRISE_ID": "TSTLKL",
    "OPERA_HOTEL_IDS": "KAT,TSK",
    "REFRESH_STALE_MINUTES": "30",
    "GMAIL_RECONCILE_ENABLED": "true",
    "GOOGLE_PROJECT_NUMBER": "208708155572",
    "GMAIL_RECONCILE_BATCH": "3",
    "OPERA_REFRESH_ENABLED": "true",
    "DOC_UPLOAD_MAX_BYTES": "20971520",
    "DOC_EDITOR_MAX_BYTES": "67108864",
    "OPERA_TIMEOUT_MS": "60000"
  },
  "observability": { "enabled": false }
}
